@model AccordionItemTagHelper

<h2 class="accordion-header">
    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#@Model.Id" aria-expanded="@(Model.Expand ? "true" : "false")" aria-controls="@($"{Model.Id}-item")">
        @Model.Title
    </button>
</h2>
<div id="@($"{Model.Id}-item")"" class="accordion-collapse collapse @(Model.Expand ? "show" : "")" data-bs-parent="#@Model.ParentId">
    <div class="accordion-body">
        @Html.Raw(Model.InnerHtml)
    </div>
</div>
